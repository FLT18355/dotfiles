{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/images/*.png",
        "type": "kitty",
        "height": 28,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 1
        }
    },
    "display": {
        "separator": "  󰁔  ",
        "color": {
            "keys": "blue"
        }
    },
    "modules": [
        // ================= 顶部：系统信息 =================
        {
            "type": "custom",
            "format": "\u001b[38;2;180;190;254m  󰣇  本喵的系统喵~\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;180;190;254m╭─────────────────────────────────────────────────────────╮\u001b[0m"
        },
        {
            "type": "os",
            "key": "  󰌽 系统喵",
            "keyColor": "#b4befe",
            "format": "\u001b[38;2;243;139;168mArch \u001b[38;2;250;179;135m(Btw) \u001b[38;2;249;226;175mx\u001b[38;2;166;227;161m8\u001b[38;2;148;226;213m6\u001b[38;2;137;180;250m_\u001b[38;2;203;166;247m67\u001b[0m"
        },
        {
            "type": "kernel",
            "key": "  󰒓 核心喵",
            "keyColor": "#b4befe",
            "format": "\u001b[38;2;250;179;135m{1} {2}\u001b[0m"
        },
        {
            "type": "command",
            "key": "  󰏗 软糖包",
            "keyColor": "#a6e3a1",
            "text": "~/.config/fastfetch/pkg_count.sh"
        },
        {
            "type": "wm",
            "key": "  󰖲 窗口喵",
            "keyColor": "#f9e2af",
            "format": "\u001b[38;2;245;194;231m{pretty-name} {version}\u001b[0m"
        },
        {
            "type": "de",
            "key": "  󰟀 桌面喵",
            "keyColor": "#f9e2af",
            "format": "\u001b[38;2;203;166;247m{pretty-name} {version}\u001b[0m"
        },
        {
            "type": "terminal",
            "key": "  󰆍 猫窝喵",
            "keyColor": "#94e2d5",
            "format": "\u001b[38;2;203;166;247mFLT18355\u001b[38;2;166;227;161m的\u001b[38;2;249;226;175m猫窝 \u001b[38;2;137;220;235m({1})\u001b[0m"
        },
        {
            "type": "terminalfont",
            "key": "  󰛖 字体喵",
            "keyColor": "#94e2d5",
            "format": "\u001b[38;2;180;190;254m{1}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;180;190;254m╰─────────────────────────────────────────────────────────╯\u001b[0m"
        },
        "break",

        // ================= 中部：硬件与开发环境 =================
        {
            "type": "title",
            "key": "  󰀄 铲屎官"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m╭─────────────────────────────────────────────────────────╮\u001b[0m"
        },
        {
            "type": "cpu",
            "key": "  󰻠 大脑喵",
            "keyColor": "#cba6f7",
            "format": "\u001b[38;2;235;160;172m{1}\u001b[0m"
        },
        {
            "type": "gpu",
            "key": "  󰢮 画图喵",
            "keyColor": "#cba6f7",
            "format": "\u001b[38;2;148;226;213m{1} {2}\u001b[0m"
        },
        {
            "type": "command",
            "key": "  󰍛 记忆喵",
            "keyColor": "#fab387",
            "text": "~/.config/fastfetch/rainbow_bar.sh"
        },
        {
            "type": "command",
            "key": "  󰞀 壳壳喵",
            "keyColor": "#fab387",
            "text": "~/.config/fastfetch/shell_info.sh"
        },
        {
            "type": "command",
            "key": "  󰌠 蟒蛇喵",
            "keyColor": "#a6e3a1",
            "text": "~/.config/fastfetch/python_info.sh"
        },
        {
            "type": "command",
            "key": "  󰎙 节点喵",
            "keyColor": "#a6e3a1",
            "text": "~/.config/fastfetch/node_info.sh"
        },
        {
            "type": "host",
            "key": "  󰟀 机器喵",
            "keyColor": "#f38ba8",
            "format": "\u001b[38;2;250;179;135m{name}\u001b[0m"
        },
        {
            "type": "uptime",
            "key": "  󰔛 醒着喵",
            "keyColor": "#f38ba8",
            // 👇 修复：使用正确的命名占位符组合
            "format": "\u001b[38;2;249;226;175m{days}d {hours}h {minutes}m\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m╰─────────────────────────────────────────────────────────╯\u001b[0m"
        },
        "break",

        // ================= 底部：时间、年龄与色板 =================
        {
            "type": "custom",
            "format": "\u001b[38;2;166;227;161m  󱫐  时间与杂鱼喵~\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;166;227;161m╭─────────────────────────────────────────────────────────╮\u001b[0m"
        },
        {
            "type": "datetime",
            "key": "  󱑎 现在喵",
            "keyColor": "#94e2d5",
            "format": "\u001b[38;2;137;220;235m{1}-{2}-{3} {4}:{5}\u001b[0m"
        },
        {
            "type": "command",
            "key": "  󰃭 几岁喵",
            "keyColor": "#f9e2af",
            "text": "if [ -f /etc/install-date ]; then install_date=$(date -d $(cat /etc/install-date) +%s); current=$(date +%s); echo $(( (current - install_date) / 86400 )) days; else echo '未知喵~'; fi"
        },
        {
            "type": "custom",
            "key": "  󰗊 语言喵",
            "keyColor": "#b4befe",
            "format": "\u001b[38;2;245;194;231m喵星语\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;166;227;161m╰─────────────────────────────────────────────────────────╯\u001b[0m"
        },
        {
            "type": "colors",
            "paddingLeft": 3,
            "symbol": "circle"
        },
        "break"
    ]
}