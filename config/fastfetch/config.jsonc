{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
	    "source": "~/.config/fastfetch/images/arch.png",
	    "type": "kitty",
	    "height": 14,
	    "padding": {
		    "top": 1
	    }
    },
    "display": {
        "separator": " : "
    },
    "modules": [
        {
            "type": "custom",
            "format": "\u001b[36m    OS Info"
        },
        {
            "type": "custom",
            "format": "┌─────────────────────────────────────────────────────────┐"
        },
        {
            "type": "os",
            "key": "  󰣇 OS",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "   Kernel",
            "keyColor": "red"
        },
        {
            "type": "packages",
            "key": "  󰏗 Packages",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "  @ Display",
            "keyColor": "green"
        },
        {
            "type": "theme",
            "key": "   Theme",
            "keyColor": "cyan",
            "format": "{1}"
        },
        {
            "type": "cursor",
            "key": "  󰇀 Cursor",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "   WM",
                // "format": "{2}",
            "keyColor": "yellow"
        },
        {
            "type": "de",
            "key": "   DE",
            "keyColor": "yellow"
        },
        {
            "type": "terminalfont",
            "key": "   Font",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": "   Terminal",
            "format": "{1}",
            "keyColor": "yellow"
        },

        {
            "type": "custom",
            "format": "└─────────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "title",
            "key": "  "
        },
        {
            "type": "custom",
            "format": "┌─────────────────────────────────────────────────────────┐"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": "   CPU",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "format": "{1} {2} {12} Ghz",
            "key": "  󰋵 GPU",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "format": "{1} {4}",
            "key": "   Shell",
            "keyColor": "magenta"
        },
        {
            "type": "command",
            "key": "   Python",
            "keyColor": "magenta",
            "text": "python --version",
            "output": "{1}"
        },
        {
            "type": "command",
            "key": "   Node.js",
            "keyColor": "magenta",
            "text": "node --version",
            "output": "{1}"
        },
        // {
        //     "type": "command",
        //     "key": "   Rust",
        //     "keyColor": "magenta",
        //     "text": "rustc --version",
        //     // "output": "{version}"
        //     "format-output": "{1}"
        // },
        {
             "type": "memory",
            "key": "  󰀚 Memory",
            "keyColor": "magenta"
        },      
        {
            "type": "command",
            "key": "  󱦟 OS Age ",
            "keyColor": "31",
            "text": "install_date=$(date -d $(cat /etc/install-date) +%s); current=$(date +%s); echo $(( (current - install_date) / 86400 )) days"
        },
        {
            "type": "uptime",
            "key": "  󱫐 Uptime ",
            "keyColor": "red"
        },
        {
            "type": "host",
            "key": "   Machine",
            "format": "{name}{?vendor} ({vendor}){?}",
            "keyColor": "red"
        },
        {
            "type": "locale",
            "key": "   locale",
            "keyColor": "red"
        },
        {
            "type": "custom",
            "format": "└─────────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"

    ]
}
