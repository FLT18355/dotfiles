{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/images/*.png",
        "type": "kitty",
        "height": 28,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 1
        }
    },
    "display": {
        "separator": "    ",
        "color": {
            "keys": "blue"
        }
    },
    "modules": [
        // ================= 顶部：系统信息 =================
        {
            "type": "custom",
            "format": "\u001b[38;2;180;190;254m  󰣇  SYSTEM & ENVIRONMENT\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;180;190;254m╭─────────────────────────────────────────────────────────╮\u001b[0m"
        },
        {
            "type": "os",
            "key": "  󰣇 OS",
            "keyColor": "blue" // 基础色，支持
        },
        {
            "type": "kernel",
            "key": "   Kernel",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "  󰏗 Packages",
            "keyColor": "green" // 基础色，支持
        },
        {
            "type": "wm",
            "key": "   WM",
            "keyColor": "yellow"
        },
        {
            "type": "de",
            "key": "   DE",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": "   Terminal",
            "format": "{1}",
            "keyColor": "#94e2d5" // 改为十六进制: Catppuccin Teal
        },
        {
            "type": "terminalfont",
            "key": "   Font",
            "keyColor": "#94e2d5"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;180;190;254m╰─────────────────────────────────────────────────────────╯\u001b[0m"
        },
        "break",

        // ================= 中部：硬件与开发环境 =================
        {
            "type": "title",
            "key": "   User"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m╭─────────────────────────────────────────────────────────╮\u001b[0m"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": "   CPU",
            "keyColor": "#cba6f7" // 改为十六进制: Catppuccin Mauve
        },
        {
            "type": "gpu",
            "format": "{1} {2}",
            "key": "  󰋵 GPU",
            "keyColor": "#cba6f7"
        },
        {
            "type": "memory",
            "key": "  󰀚 Memory",
            "keyColor": "#fab387" // 改为十六进制: Catppuccin Peach
        },
        {
            "type": "shell",
            "format": "{1} {4}",
            "key": "   Shell",
            "keyColor": "#fab387"
        },
        {
            "type": "command",
            "key": "   Python",
            "keyColor": "green",
            "text": "python --version",
            "output": "{1}"
        },
        {
            "type": "command",
            "key": "   Node.js",
            "keyColor": "green",
            "text": "node --version",
            "output": "{1}"
        },
        {
            "type": "host",
            "key": "   Machine",
            "format": "{name}{?vendor} ({vendor}){?}",
            "keyColor": "red"
        },
        {
            "type": "uptime",
            "key": "  󱫐 Uptime",
            "keyColor": "red"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m╰─────────────────────────────────────────────────────────╯\u001b[0m"
        },
        "break",

        // ================= 底部：时间、年龄与色板 =================
        {
            "type": "custom",
            "format": "\u001b[38;2;166;227;161m  󱫐  TIME & MISC\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;166;227;161m╭─────────────────────────────────────────────────────────╮\u001b[0m"
        },
        {
            "type": "datetime",
            "key": "   Time",
            "keyColor": "#94e2d5",
            "format": "{1}-{2}-{3} {4}:{5}"
        },
        {
            "type": "command",
            "key": "  󱦟 OS Age",
            "keyColor": "yellow",
            "text": "install_date=$(date -d $(cat /etc/install-date) +%s); current=$(date +%s); echo $(( (current - install-date) / 86400 )) days"
        },
        {
            "type": "locale",
            "key": "   Locale",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;166;227;161m╰─────────────────────────────────────────────────────────╯\u001b[0m"
        },
        {
            "type": "colors",
            "paddingLeft": 3,
            "symbol": "circle"
        },
        "break"
    ]
}