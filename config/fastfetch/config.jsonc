{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/images/*.png",
        "type": "kitty",
        "height": 28,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 1
        }
    },
    "display": {
        "separator": "  󰁔  ",
        "color": {
            "keys": "blue"
        }
    },
    "modules": [
        // ================= 顶部：系统信息 =================
        {
            "type": "custom",
            "format": "\u001b[38;2;180;190;254m  󰣇  本喵的系统喵~\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;180;190;254m╭─────────────────────────────────────────────────────────╮\u001b[0m"
        },
        {
            "type": "os",
            "key": "  󰌽 系统喵",
            "keyColor": "#b4befe",
            "format": "Arch (Btw) x86_67"
        },
        {
            "type": "kernel",
            "key": "  󰒓 内核喵",
            "keyColor": "#b4befe"
        },
        {
            "type": "packages",
            "key": "  󰏗 软糖包",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "wm",
            "key": "  󰖲 窗口喵",
            "keyColor": "#f9e2af"
        },
        {
            "type": "de",
            "key": "  󰟀 桌面喵",
            "keyColor": "#f9e2af"
        },
        {
            "type": "terminal",
            "key": "  󰆍 终端喵",
            "format": "{1}",
            "keyColor": "#94e2d5"
        },
        {
            "type": "terminalfont",
            "key": "  󰛖 字体喵",
            "keyColor": "#94e2d5"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;180;190;254m╰─────────────────────────────────────────────────────────╯\u001b[0m"
        },
        "break",

        // ================= 中部：硬件与开发环境 =================
        {
            "type": "title",
            "key": "  󰀄 铲屎官"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m╭─────────────────────────────────────────────────────────╮\u001b[0m"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": "  󰻠 大脑喵",
            "keyColor": "#cba6f7"
        },
        {
            "type": "gpu",
            "format": "{1} {2}",
            "key": "  󰢮 画图喵",
            "keyColor": "#cba6f7"
        },
        {
            "type": "command",
            "key": "  󰍛 记忆喵",
            "keyColor": "#fab387",
            "text": "~/.config/fastfetch/rainbow_bar.sh"
        },
        {
            "type": "shell",
            "format": "{1} {4}",
            "key": "  󰞀 壳壳喵",
            "keyColor": "#fab387"
        },
        {
            "type": "command",
            "key": "  󰌠 蟒蛇喵",
            "keyColor": "#a6e3a1",
            "text": "python --version 2>/dev/null || echo '未安装喵'",
            "output": "{1}"
        },
        {
            "type": "command",
            "key": "  󰎙 节点喵",
            "keyColor": "#a6e3a1",
            "text": "node --version 2>/dev/null || echo '未安装喵'",
            "output": "{1}"
        },
        {
            "type": "host",
            "key": "  󰟀 机器喵",
            "format": "{name}{?vendor} ({vendor}){?}",
            "keyColor": "#f38ba8"
        },
        {
            "type": "uptime",
            "key": "  󰔛 醒着喵",
            "keyColor": "#f38ba8"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m╰─────────────────────────────────────────────────────────╯\u001b[0m"
        },
        "break",

        // ================= 底部：时间、年龄与色板 =================
        {
            "type": "custom",
            "format": "\u001b[38;2;166;227;161m  󱫐  时间与杂鱼喵~\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;166;227;161m╭─────────────────────────────────────────────────────────╮\u001b[0m"
        },
        {
            "type": "datetime",
            "key": "  󱑎 现在喵",
            "keyColor": "#94e2d5",
            "format": "{1}-{2}-{3} {4}:{5}"
        },
        {
            "type": "command",
            "key": "  󰃭 几岁喵",
            "keyColor": "#f9e2af",
            "text": "if [ -f /etc/install-date ]; then install_date=$(date -d $(cat /etc/install-date) +%s); current=$(date +%s); echo $(( (current - install_date) / 86400 )) days; else echo '未知喵~'; fi"
        },
        {
            "type": "locale",
            "key": "  󰗊 语言喵",
            "keyColor": "#b4befe"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;166;227;161m╰─────────────────────────────────────────────────────────╯\u001b[0m"
        },
        {
            "type": "colors",
            "paddingLeft": 3,
            "symbol": "circle"
        },
        "break"
    ]
}