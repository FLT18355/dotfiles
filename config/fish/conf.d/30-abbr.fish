# ============================================
# 缩写 (Abbreviations)
# ============================================

abbr --add gst "git status"
abbr --add ga "git add"
abbr --add gp "git push"
abbr --add gl "git pull"
abbr --add gc "git commit"
abbr --add gd "git diff"
abbr --add g git

# GitHub Actions 快捷
abbr --add gha "gh workflow"                     # 基础命令
abbr --add gal "gh run list"                     # 列出最近的 Action 运行记录 (List)
abbr --add gaw "gh run watch"                    # 实时监控最新运行的进度 (Watch)
abbr --add gav "gh run view"                     # 查看某次运行的详细结果 (View)
abbr --add gaf "gh run view --log-failed"        # 一键查看失败日志 (Fail) - 排错神器
abbr --add gar2 "gh run rerun"                   # 重新运行失败的 Action (Rerun)
abbr --add gad "gh run download"
abbr --add gar "gh workflow run"

# pacman快捷
abbr --add btwi "btw -S"
abbr --add btwy "btw -Sy"
abbr --add btwyy "btw -Syy"
abbr --add btwu "btw -Syu"