"$schema" = 'https://starship.rs/config-schema.json'

scan_timeout = 500

# ==========================================
# 布局配置 (紫色系主导 Powerline)
# ==========================================
format = """
[](mauve)\
$os\
$username\
[](bg:pink fg:mauve)\
$directory\
[](bg:lavender fg:pink)\
$git_branch\
$git_status\
[](bg:blue fg:lavender)\
$c\
$rust\
$golang\
$nodejs\
$bun\
$python\
[](bg:yellow fg:blue)\
$conda\
[](bg:surface1 fg:yellow)\
$time\
$cmd_duration\
[ ](fg:surface1)\
$line_break\
$character"""

palette = 'catppuccin_mocha'

# ==========================================
# 系统信息模块 (主紫色)
# ==========================================
[os]
disabled = false
style = "bg:mauve fg:crust"
format = '[$symbol]($style)'

[os.symbols]
Arch = "󰣇"

[username]
show_always = true
style_user = "bg:mauve fg:crust"
style_root = "bg:mauve fg:crust"
format = '[ $user ]($style)'

# ==========================================
# 路径与 Git 模块 (粉紫、淡紫)
# ==========================================
[directory]
style = "bg:pink fg:crust"
format = "[ 󰉋 $path ]($style)"
truncation_length = 3

[git_branch]
symbol = "󰊢"
style = "bg:lavender fg:crust"
format = '[ $symbol $branch ]($style)'

[git_status]
style = "bg:lavender fg:crust"
format = '[($all_status$ahead_behind )]($style)'

# ==========================================
# 语言环境模块 (蓝色辅助色)
# ==========================================
[nodejs]
symbol = ""
style = "bg:blue fg:crust"
format = '[ $symbol $version ]($style)'

[bun]
symbol = ""
style = "bg:blue fg:crust"
format = '[ $symbol $version ]($style)'

[c]
symbol = " "
style = "bg:blue fg:crust"
format = '[ $symbol $version ]($style)'

[rust]
symbol = ""
style = "bg:blue fg:crust"
format = '[ $symbol $version ]($style)'

[golang]
symbol = ""
style = "bg:blue fg:crust"
format = '[ $symbol $version ]($style)'

[python]
symbol = ""
style = "bg:blue fg:crust"
format = '[ $symbol $version ]($style)'

[conda]
symbol = "󰐊"
style = "bg:yellow fg:crust"
format = '[ $symbol $environment ]($style)'

# ==========================================
# 时间 + 命令耗时（同一块 surface1 灰紫）
# ==========================================
[time]
disabled = false
time_format = "%R"
style = "bg:surface1 fg:text"
format = '[ 󱑎 $time ]($style)'

[cmd_duration]
show_milliseconds = false
format = "[ 󱎫 $duration ]($style)"
style = "bg:surface1 fg:peach"
disabled = false
min_time_to_notify = 45000

# ==========================================
# 其他信息模块
# ==========================================
[line_break]
disabled = false

[character]
disabled = false
# 去除多余空格，顶格显示
success_symbol = '[ ](bold fg:mauve)'
error_symbol = '[ ](bold fg:red)'

# ==========================================
# Catppuccin Mocha 调色板
# ==========================================
[palettes.catppuccin_mocha]
rosewater = "#f5e0dc"
flamingo = "#f2cdcd"
pink = "#f5c2e7"
mauve = "#cba6f7"
red = "#f38ba8"
maroon = "#eba0ac"
peach = "#fab387"
yellow = "#f9e2af"
green = "#a6e3a1"
teal = "#94e2d5"
sky = "#89dceb"
sapphire = "#74c7ec"
blue = "#89b4fa"
lavender = "#b4befe"
text = "#cdd6f4"
subtext1 = "#bac2de"
subtext0 = "#a6adc8"
overlay2 = "#9399b2"
overlay1 = "#7f849c"
overlay0 = "#6c7086"
surface2 = "#585b70"
surface1 = "#45475a"
surface0 = "#313244"
base = "#1e1e1e2e"
mantle = "#181825"
crust = "#11111b"