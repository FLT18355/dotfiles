# ==========================================
# 基础长度限制
# ==========================================

# 标题总长度上限
HERDR_AUTO_TITLE_MAX_LENGTH=50

# 目录名长度上限（如果当前目录名字很长，会被截断到这个长度）
HERDR_AUTO_TITLE_DIRECTORY_MAX=25

# Git 分支名长度上限
HERDR_AUTO_TITLE_BRANCH_MAX=12

# ==========================================
# 颜值与视觉增强
# ==========================================

# 开启 Nerd Font 图标（比如显示文件夹、Git、终端图标），前提是你终端字体是 Nerd Font
HERDR_AUTO_TITLE_ICONS=true

# 在标题最前面加上该标签页的序号（例如 "1: api-server"）
HERDR_AUTO_TITLE_POSITION=true

# 如果你希望在标签页前面显示 AI Agent 的状态图标（如：空闲、思考、阻塞）
# ◉ idle, ◐ working, ● blocked, ✓ done
HERDR_AUTO_TITLE_AGENT_STATUS=true

# ==========================================
# 行为逻辑调整
# ==========================================

# 让窗格也拥有名字（Herdr 的 goto 面板会用这个名字找窗格）
HERDR_AUTO_TITLE_PANES=true

# 如果一个标签页里有多个窗格，优先以 Agent 所在的窗格命名
HERDR_AUTO_TITLE_PREFER_AGENT=true

# 在窗格名字前面带上 Agent 的名字（比如 "claude › api"）
HERDR_AUTO_TITLE_AGENT_NAME=true

# 开启工作区主题汇报（让侧边栏能显示当前活动标签页在干嘛）
HERDR_AUTO_TITLE_WORKSPACES=true