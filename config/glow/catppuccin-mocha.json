{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#cdd6f4",
    "margin": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#cdd6f4",
    "bold": true
  },
  "h1": {
    "prefix": "▓▓▓ ",
    "suffix": " ",
    "color": "#cba6f7",
    "bold": true
  },
  "h2": {
    "prefix": "▓▓▓▓ ",
    "color": "#f5c2e7",
    "bold": true
  },
  "h3": {
    "prefix": "▓▓▓▓▓ ",
    "color": "#b4befe",
    "bold": true
  },
  "h4": {
    "prefix": "▓▓▓▓▓▓ ",
    "color": "#89b4fa"
  },
  "h5": {
    "prefix": "▓▓▓▓▓▓▓ ",
    "color": "#94e2d5"
  },
  "h6": {
    "prefix": "▓▓▓▓▓▓▓▓ ",
    "color": "#a6adc8"
  },
  "paragraph": {},
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#b4befe"
  },
  "list": {
    "level_indent": 2,
    "color": "#cdd6f4"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#89b4fa",
    "underline": true
  },
  "link_text": {
    "color": "#b4befe",
    "bold": true
  },
  "image": {
    "color": "#89b4fa",
    "underline": true
  },
  "image_text": {
    "color": "#b4befe",
    "format": "Image: {{.text}} →"
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true,
    "color": "#f5c2e7"
  },
  "hr": {
    "color": "#6c7086",
    "format": "\n--------\n"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#cba6f7",
    "background_color": "#181825"
  },
  "code_block": {
    "color": "#181825",
    "margin": 2,
    "chroma": {
      "text": { "color": "#cdd6f4" },
      "error": { "color": "#cdd6f4", "background_color": "#f38ba8" },
      "comment": { "color": "#6c7086" },
      "comment_preproc": { "color": "#89b4fa" },
      "keyword": { "color": "#cba6f7" },
      "keyword_reserved": { "color": "#cba6f7" },
      "keyword_namespace": { "color": "#f5c2e7" },
      "keyword_type": { "color": "#b4befe" },
      "operator": { "color": "#89dceb" },
      "punctuation": { "color": "#9399b2" },
      "name": { "color": "#cdd6f4" },
      "name_builtin": { "color": "#89b4fa" },
      "name_tag": { "color": "#cba6f7" },
      "name_attribute": { "color": "#f9e2af" },
      "name_class": { "color": "#f5c2e7" },
      "name_constant": { "color": "#f5c2e7" },
      "name_decorator": { "color": "#f9e2af" },
      "name_exception": { "color": "#f38ba8" },
      "name_function": { "color": "#b4befe" },
      "name_other": { "color": "#cdd6f4" },
      "literal": { "color": "#f5c2e7" },
      "literal_number": { "color": "#fab387" },
      "literal_date": { "color": "#f5c2e7" },
      "literal_string": { "color": "#a6e3a1" },
      "literal_string_escape": { "color": "#f5c2e7" },
      "generic_deleted": { "color": "#f38ba8" },
      "generic_emph": { "color": "#cdd6f4", "italic": true },
      "generic_inserted": { "color": "#a6e3a1" },
      "generic_strong": { "color": "#cdd6f4", "bold": true },
      "generic_subheading": { "color": "#6c7086" }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "table_header": {
    "color": "#cba6f7",
    "bold": true
  },
  "table_cell": {
    "color": "#cdd6f4"
  }
}